# ===== 应用配置 =====
APP_NAME=DeviceAccessControl
APP_ENV=development
LOG_LEVEL=INFO

# ===== 数据库 =====
DATABASE_URL=sqlite:///./data/app.db

# ===== 网络 =====
LAN_INTERFACE=               # 监听的网卡;留空则自动识别(Windows 建议留空)
LAN_CIDR=192.168.1.0/24      # 留空则按网卡自动推断
SCAN_INTERVAL_SEC=30         # ARP 扫描周期 (秒)
# Windows: 需先装 Npcap (勾选 "WinPcap API-compatible Mode") 才能做 ARP 扫描

# ===== 阻断 =====
BLOCKER_BACKEND=deauth        # deauth(WiFi踢下线,对付苹果首选) / arp / route / netsh(Windows) / iptables(Linux) / none
BLOCKER_REQUIRE_CONFIRM=true # 阻断动作是否要求人工二次确认

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=change-me-please   # 简易 Bearer Token,生产请改

# ===== 前端 =====
VITE_API_BASE=http://localhost:8000/api/v1
VITE_WS_BASE=ws://localhost:8000/ws
